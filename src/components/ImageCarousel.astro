---
// Image carousel for the detail view (spec §5.3a, §6.3). Images arrive already
// ordered (primary first, then sort_order). Keyboard accessible (prev/next +
// arrow keys), thumbnail navigation, reduced-motion honoured. Explicit
// dimensions on every slide so the viewport never shifts (CLS).
import { imageUrl, IMAGE_VARIANTS } from '../lib/images';
import type { DetailImage } from '../lib/listings';

interface Props {
  images: DetailImage[];
  title: string;
}

const { images, title } = Astro.props;
const main = IMAGE_VARIANTS.carousel;
const thumb = IMAGE_VARIANTS.thumb;
const hasImages = images.length > 0;
---

<div class="carousel" data-carousel>
  <div class="viewport" tabindex="0" role="group" aria-roledescription="carousel" aria-label={`${title} images`}>
    {
      hasImages ? (
        <div class="track" data-track>
          {images.map((img, i) => (
            <div class="slide" role="group" aria-roledescription="slide" aria-label={`Image ${i + 1} of ${images.length}`}>
              <img
                src={imageUrl(img.r2Key, 'carousel')}
                width={main.width}
                height={main.height}
                alt={img.alt ?? `${title} — image ${i + 1}`}
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
                onerror="this.closest('.slide').classList.add('slide--failed')"
              />
              <div class="ph" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="3" y="5" width="18" height="14" rx="2" />
                  <circle cx="8.5" cy="10" r="1.5" />
                  <path d="M21 17l-5-5L5 21" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="empty" aria-label="No images available">
          <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <circle cx="8.5" cy="10" r="1.5" />
            <path d="M21 17l-5-5L5 21" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span>No images yet</span>
        </div>
      )
    }

    {
      images.length > 1 && (
        <>
          <button class="nav prev" type="button" aria-label="Previous image" data-prev>
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M15 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <button class="nav next" type="button" aria-label="Next image" data-next>
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <p class="counter" aria-live="polite" data-counter>1 / {images.length}</p>
        </>
      )
    }
  </div>

  {
    images.length > 1 && (
      <div class="thumbs" role="group" aria-label="Image thumbnails">
        {images.map((img, i) => (
          <button
            class="thumb"
            type="button"
            aria-pressed={i === 0 ? 'true' : 'false'}
            aria-label={`Show image ${i + 1}`}
            data-thumb={i}
          >
            <img
              src={imageUrl(img.r2Key, 'thumb')}
              width={thumb.width}
              height={thumb.height}
              alt=""
              loading="lazy"
              decoding="async"
              onerror="this.style.visibility='hidden'"
            />
          </button>
        ))}
      </div>
    )
  }
</div>

<style>
  .viewport {
    position: relative;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-surface-2);
  }
  .viewport:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .track {
    display: flex;
    transition: transform 0.3s ease;
  }
  @media (prefers-reduced-motion: reduce) {
    .track {
      transition: none;
    }
  }

  .slide {
    position: relative;
    flex: 0 0 100%;
    aspect-ratio: 3 / 2;
  }
  .slide img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .slide .ph {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--color-muted);
  }
  .slide:has(img):not(.slide--failed) .ph {
    display: none;
  }
  .slide--failed img {
    display: none;
  }

  .empty {
    display: grid;
    place-items: center;
    gap: var(--space-2);
    aspect-ratio: 3 / 2;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
    background: rgba(32, 32, 32, 0.7);
    color: var(--color-text);
    cursor: pointer;
  }
  .nav:hover {
    background: var(--color-primary);
    color: var(--color-primary-ink);
    border-color: var(--color-primary);
  }
  .prev {
    left: var(--space-3);
  }
  .next {
    right: var(--space-3);
  }
  .counter {
    position: absolute;
    bottom: var(--space-3);
    right: var(--space-3);
    margin: 0;
    padding: 0.2em 0.6em;
    border-radius: var(--radius-pill);
    background: rgba(32, 32, 32, 0.7);
    color: var(--color-text);
    font-size: var(--text-xs);
  }

  .thumbs {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-3);
    overflow-x: auto;
    padding-bottom: var(--space-1);
  }
  .thumb {
    flex: 0 0 auto;
    width: 84px;
    aspect-ratio: 4 / 3;
    padding: 0;
    border: 2px solid transparent;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-surface-2);
    cursor: pointer;
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .thumb[aria-pressed='true'] {
    border-color: var(--color-primary);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]');
    const slides = track ? Array.from(track.children) : [];
    const thumbs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-thumb]'));
    const counter = root.querySelector<HTMLElement>('[data-counter]');
    const viewport = root.querySelector<HTMLElement>('.viewport');
    if (!track || slides.length <= 1) return;

    let index = 0;
    const go = (next: number) => {
      index = (next + slides.length) % slides.length;
      track.style.transform = `translateX(-${index * 100}%)`;
      thumbs.forEach((t, i) => t.setAttribute('aria-pressed', String(i === index)));
      if (counter) counter.textContent = `${index + 1} / ${slides.length}`;
    };

    root.querySelector('[data-prev]')?.addEventListener('click', () => go(index - 1));
    root.querySelector('[data-next]')?.addEventListener('click', () => go(index + 1));
    thumbs.forEach((t, i) => t.addEventListener('click', () => go(i)));

    viewport?.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        go(index - 1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        go(index + 1);
      }
    });
  });
</script>
