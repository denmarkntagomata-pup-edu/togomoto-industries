---
// Listing card (spec §6.1). Renders one listing in grids and carousels: primary
// image (R2 → Image Transformations, explicit w/h so no CLS, lazy below fold),
// title, price/POA, maker·model, key facts, status badge, optional "Recent
// arrival" tag. The whole card links to the detail view. Reuses formatPrice
// (AGENTS.md §6) and the enum slug map so hrefs never drift.
import type { Listing } from '../db/schema';
import { SLUG_BY_CATEGORY, type Category } from '../db/enums';
import { formatPrice, labelForEnum } from '../lib/format';
import { imageUrl, IMAGE_VARIANTS } from '../lib/images';

interface Props {
  listing: Listing;
  /** Primary image for the listing, if any. */
  image?: { r2Key: string; alt: string | null } | null;
  /** Show the "Recent arrival" tag (host decides, e.g. home carousels). */
  recentArrival?: boolean;
  /** Above-the-fold cards should load eagerly; default lazy. */
  eager?: boolean;
}

const { listing, image = null, recentArrival = false, eager = false } = Astro.props;

const { width, height } = IMAGE_VARIANTS.card;
const href = `/products/${SLUG_BY_CATEGORY[listing.category as Category]}/${listing.slug}`;
const price = formatPrice(listing.price, listing.priceOnApplication);

// Status badge: shared label, semantic colour class per sale status.
const STATUS_CLASS: Record<string, string> = {
  available: 'badge--success',
  reserved: 'badge--warning',
  sold: 'badge--danger',
  incoming: 'badge--info',
};
const statusClass = STATUS_CLASS[listing.status] ?? 'badge--muted';

const makerModel = [listing.maker, listing.model].filter(Boolean).join(' ');
const facts = [
  listing.yearOfManufacture ? String(listing.yearOfManufacture) : null,
  listing.mileage != null ? `${listing.mileage.toLocaleString('en-US')} km` : null,
  listing.location,
].filter(Boolean) as string[];
---

<a class="card" href={href}>
  <div class="media">
    {
      image && (
        <img
          src={imageUrl(image.r2Key, 'card')}
          width={width}
          height={height}
          alt={image.alt ?? listing.title}
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
          onerror="this.closest('.media').classList.add('media--failed')"
        />
      )
    }
    <div class="placeholder" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <circle cx="8.5" cy="10" r="1.5" />
        <path d="M21 17l-5-5L5 21" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </div>

    <div class="badges">
      <span class={`badge ${statusClass}`}>{labelForEnum(listing.status)}</span>
      {recentArrival && <span class="badge badge--accent">Recent arrival</span>}
    </div>
  </div>

  <div class="body">
    <p class="price">{price}</p>
    <h3 class="title">{listing.title}</h3>
    {makerModel && <p class="maker">{makerModel}</p>}
    {facts.length > 0 && <p class="facts">{facts.join(' · ')}</p>}
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    color: var(--color-text);
    text-decoration: none;
    transition:
      transform 0.15s ease,
      border-color 0.15s ease;
  }
  .card:hover {
    text-decoration: none;
    transform: translateY(-3px);
    border-color: var(--color-primary);
  }

  /* ── Media: fixed 4:3 box so the grid never shifts (CLS) ── */
  .media {
    position: relative;
    aspect-ratio: 4 / 3;
    background: var(--color-surface-2);
  }
  .media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  /* Subtle zoom on hover to make the grid feel alive (gated globally by the
     reduced-motion guard in BaseLayout). */
  .card:hover .media img {
    transform: scale(1.04);
  }
  .placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--color-muted);
  }
  /* Hide the placeholder only while a present image hasn't failed; if the image
     errors (media--failed), fall back to the placeholder (default display:grid). */
  .media:has(img):not(.media--failed) .placeholder {
    display: none;
  }
  .media--failed img {
    display: none;
  }

  .badges {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .badge {
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: 1;
    padding: 0.35em 0.6em;
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }
  .badge--success {
    background: var(--color-success);
    color: var(--color-success-ink);
  }
  .badge--warning {
    background: var(--color-warning);
    color: var(--color-warning-ink);
  }
  .badge--danger {
    background: var(--color-danger-fill);
    color: #fff;
  }
  .badge--info {
    background: var(--color-secondary);
    color: #fff;
  }
  .badge--muted {
    background: var(--color-surface-2);
    color: var(--color-muted);
  }
  .badge--accent {
    background: var(--color-primary);
    color: var(--color-primary-ink);
  }

  /* ── Body ── */
  .body {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4);
  }
  .price {
    margin: 0;
    color: var(--color-primary);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-lg);
  }
  .title {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: var(--text-base);
    line-height: 1.3;
  }
  .maker {
    margin: 0;
    color: var(--color-text);
    font-size: var(--text-sm);
  }
  .facts {
    margin: var(--space-1) 0 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
</style>
