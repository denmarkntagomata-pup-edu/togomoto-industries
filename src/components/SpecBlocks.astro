---
// Specification blocks for the detail view (spec §5.3b general, §5.3c technical).
// General mixes core columns + a few weight specs; technical is grouped from the
// specs JSON. Rows with no value are omitted; empty groups/blocks disappear.
import type { Listing, ListingSpecs } from '../db/schema';
import { labelForEnum } from '../lib/format';

interface Props {
  listing: Listing;
}

const { listing } = Astro.props;
const specs: ListingSpecs = listing.specs ?? {};

type Val = string | number | null | undefined;
interface Row {
  label: string;
  value: Val;
}
const present = (rows: Row[]) =>
  rows.filter((r) => r.value !== null && r.value !== undefined && String(r.value).trim() !== '');

// dimensions may be a free string or a {length,width,height} object.
function formatDimensions(d: ListingSpecs['dimensions']): Val {
  if (d == null) return null;
  if (typeof d === 'string' || typeof d === 'number') return d;
  const parts = [d.length, d.width, d.height].filter((p) => p != null && String(p).trim() !== '');
  return parts.length ? parts.join(' × ') : null;
}

const general = present([
  { label: 'Unit type', value: listing.body },
  { label: 'Brand / maker', value: listing.maker },
  { label: 'Model', value: listing.model },
  { label: 'Reference number', value: listing.referenceNumber },
  { label: 'Year of manufacture', value: listing.yearOfManufacture },
  { label: 'Mileage', value: listing.mileage != null ? `${listing.mileage.toLocaleString('en-US')} km` : null },
  { label: 'Net weight', value: specs.net_weight },
  { label: 'Gross weight', value: specs.gross_weight },
  { label: 'Payload', value: specs.payload },
  { label: 'Color', value: listing.color },
  { label: 'Location', value: listing.location },
]);

const technicalGroups = [
  {
    heading: 'Engine',
    rows: present([
      { label: 'Fuel', value: listing.fuelType ? labelForEnum(listing.fuelType) : null },
      { label: 'Engine', value: specs.engine },
    ]),
  },
  {
    heading: 'Performance',
    rows: present([
      { label: 'Top speed', value: specs.top_speed },
      { label: 'Acceleration 0–62 mph', value: specs.acceleration_0_62 },
    ]),
  },
  {
    heading: 'Transmission',
    rows: present([
      { label: 'Transmission', value: listing.transmissionType ? labelForEnum(listing.transmissionType) : null },
      { label: 'Drive type', value: specs.drive_type },
      { label: 'Gearbox', value: specs.gearbox },
    ]),
  },
  {
    heading: 'Dimensions & weight',
    rows: present([
      { label: 'Dimensions', value: formatDimensions(specs.dimensions) },
      { label: 'Weight', value: specs.weight },
    ]),
  },
].filter((g) => g.rows.length > 0);
---

<div class="spec-blocks">
  {
    general.length > 0 && (
      <section class="spec-card">
        <h2>General specifications</h2>
        <dl class="spec-list">
          {general.map((r) => (
            <div class="spec-row">
              <dt>{r.label}</dt>
              <dd>{r.value}</dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }

  {
    technicalGroups.length > 0 && (
      <section class="spec-card">
        <h2>Technical specifications</h2>
        {technicalGroups.map((g) => (
          <div class="spec-group">
            <h3>{g.heading}</h3>
            <dl class="spec-list">
              {g.rows.map((r) => (
                <div class="spec-row">
                  <dt>{r.label}</dt>
                  <dd>{r.value}</dd>
                </div>
              ))}
            </dl>
          </div>
        ))}
      </section>
    )
  }
</div>

<style>
  .spec-blocks {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
    align-items: start;
  }
  .spec-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
  }
  .spec-card h2 {
    font-size: var(--text-xl);
    margin: 0 0 var(--space-4);
  }
  .spec-group + .spec-group {
    margin-top: var(--space-5);
  }
  .spec-group h3 {
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    margin: 0 0 var(--space-2);
  }
  .spec-list {
    margin: 0;
  }
  .spec-row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-border);
  }
  .spec-row:last-child {
    border-bottom: 0;
  }
  .spec-row dt {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .spec-row dd {
    margin: 0;
    text-align: right;
    font-weight: 600;
  }

  @media (max-width: 760px) {
    .spec-blocks {
      grid-template-columns: 1fr;
    }
  }
</style>
