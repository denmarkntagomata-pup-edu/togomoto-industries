---
// Friendly 404. Astro serves this for unmatched routes, and our SSR pages
// `Astro.rewrite('/404')` to it for not-found data (unknown category/slug).
// Set the status explicitly so rewrites also return 404.
Astro.response.status = 404;
import BaseLayout from '../layouts/BaseLayout.astro';
import { SLUG_BY_CATEGORY } from '../db/enums';
---

<BaseLayout title="Page not found" noindex>
  <section class="container notfound">
    <p class="code">404</p>
    <h1>We couldn't find that page</h1>
    <p class="lead">The page may have moved, or the listing is no longer available.</p>
    <div class="links">
      <a class="btn" href="/">Back to home</a>
      <a class="btn btn--ghost" href={`/products/${SLUG_BY_CATEGORY.used_car}`}>Browse used cars</a>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    padding-block: var(--space-8);
    text-align: center;
  }
  .code {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-3xl);
    color: var(--color-primary);
    margin: 0;
  }
  .lead {
    color: var(--color-muted);
    max-width: 48ch;
    margin-inline: auto;
  }
  .links {
    display: flex;
    gap: var(--space-3);
    justify-content: center;
    flex-wrap: wrap;
    margin-top: var(--space-5);
  }
  .btn {
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-md);
    font-weight: 700;
    background: var(--color-primary);
    color: var(--color-primary-ink);
  }
  .btn:hover {
    text-decoration: none;
    filter: brightness(1.05);
  }
  .btn--ghost {
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }
  .btn--ghost:hover {
    border-color: var(--color-primary);
  }
</style>
