---
// Site-wide product search results (header "Search Products/Service" box). SSR —
// results are derived from the ?q= query param across all published listings
// (title/maker/model/body). Reuses ListingCard. noindex: thin, query-driven.
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import ListingCard from '../components/ListingCard.astro';
import { searchListings } from '../lib/listings';
import { setPublicCache } from '../lib/cache';

const env = Astro.locals.runtime.env;
const query = (Astro.url.searchParams.get('q') ?? '').trim();
const pageRaw = Number(Astro.url.searchParams.get('page'));
const reqPage = Number.isInteger(pageRaw) && pageRaw > 0 ? pageRaw : 1;

const { rows, total, page, pageCount } = await searchListings(env, query, reqPage);
setPublicCache(Astro.response); // anonymous, identical for a given query (P3-3)

// Pagination links preserve the query and only vary `page`.
function pageHref(n: number): string {
  const params = new URLSearchParams();
  if (query) params.set('q', query);
  if (n > 1) params.set('page', String(n));
  const s = params.toString();
  return s ? `/search?${s}` : '/search';
}
const pages = Array.from({ length: pageCount }, (_, i) => i + 1);
---

<BaseLayout
  title={query ? `Search: ${query}` : 'Search'}
  description="Search Togomoto Industries for used cars, trucks, heavy equipment and parts."
  noindex
>
  <div class="container page">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> <span aria-hidden="true">/</span>
      <span class="current">Search</span>
    </nav>

    <header class="intro">
      <h1>Search</h1>
      <form class="search-form" role="search" action="/search" method="get">
        <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <input
          type="search"
          name="q"
          value={query}
          placeholder="Search products & services"
          aria-label="Search products and services"
          autocomplete="off"
        />
        <button type="submit">Search</button>
      </form>
      {
        query && (
          <p class="count">
            {total === 0
              ? `No results for “${query}”.`
              : `${total} result${total === 1 ? '' : 's'} for “${query}”.`}
          </p>
        )
      }
    </header>

    {
      !query ? (
        <p class="hint">Type a maker, model or keyword above to search our inventory.</p>
      ) : rows.length === 0 ? (
        <div class="empty">
          <p>Nothing matched your search. Try a different keyword, or browse our categories.</p>
          <a class="browse-link" href="/products/used-trucks">Browse inventory →</a>
        </div>
      ) : (
        <div class="card-grid">
          {rows.map((r, i) => (
            <ListingCard listing={r.listing} image={r.image} eager={i < 3} />
          ))}
        </div>
      )
    }

    {
      pageCount > 1 && (
        <nav class="pagination" aria-label="Pagination">
          <a class="page-btn" href={pageHref(page - 1)} aria-disabled={page <= 1} tabindex={page <= 1 ? -1 : undefined}>
            Prev
          </a>
          {pages.map((n) => (
            <a class="page-btn" href={pageHref(n)} aria-current={n === page ? 'page' : undefined}>
              {n}
            </a>
          ))}
          <a class="page-btn" href={pageHref(page + 1)} aria-disabled={page >= pageCount} tabindex={page >= pageCount ? -1 : undefined}>
            Next
          </a>
        </nav>
      )
    }
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: var(--space-5) var(--space-7);
  }
  .crumbs {
    color: var(--color-muted);
    font-size: var(--text-sm);
    margin-bottom: var(--space-5);
  }
  .crumbs a {
    color: var(--color-muted);
  }
  .crumbs a:hover {
    color: var(--color-primary);
  }
  .crumbs .current {
    color: var(--color-text);
  }

  .intro {
    margin-bottom: var(--space-6);
  }
  .intro h1 {
    margin-bottom: var(--space-4);
  }

  .search-form {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    max-width: 640px;
    padding: var(--space-2) var(--space-3);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
  }
  .search-form:focus-within {
    border-color: var(--color-primary);
  }
  .search-icon {
    flex: none;
    color: var(--color-muted);
  }
  .search-form input {
    flex: 1;
    min-width: 0;
    background: none;
    border: 0;
    color: var(--color-text);
    font: inherit;
  }
  .search-form input::placeholder {
    color: var(--color-muted);
  }
  .search-form input:focus {
    outline: none;
  }
  .search-form button {
    flex: none;
    padding: var(--space-2) var(--space-5);
    background: var(--color-primary);
    color: var(--color-primary-ink);
    border: 0;
    border-radius: var(--radius-pill);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  .search-form button:hover {
    filter: brightness(1.05);
  }

  .count {
    margin: var(--space-4) 0 0;
    color: var(--color-muted);
  }
  .hint {
    color: var(--color-muted);
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }

  .empty {
    padding: var(--space-8) var(--space-5);
    text-align: center;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    color: var(--color-muted);
  }
  .browse-link {
    display: inline-block;
    margin-top: var(--space-3);
    color: var(--color-primary);
    font-weight: 600;
  }

  .pagination {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-6);
  }
  .page-btn {
    min-width: 40px;
    padding: var(--space-2) var(--space-3);
    text-align: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-weight: 600;
  }
  .page-btn:hover {
    text-decoration: none;
    border-color: var(--color-primary);
  }
  .page-btn[aria-current='page'] {
    background: var(--color-primary);
    color: var(--color-primary-ink);
    border-color: var(--color-primary);
  }
  .page-btn[aria-disabled='true'] {
    opacity: 0.4;
    pointer-events: none;
  }

  @media (max-width: 900px) {
    .card-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .card-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
