---
// Announcements index (spec §5.8, PLAN P2-5). SSR — published announcements
// ordered by published_at DESC, offset-paginated. Each card shows the cover
// image, title, excerpt, date, and links to the detail page. Reuses the
// pagination pattern from the category listing page.
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedAnnouncements } from '../../lib/announcements';
import { formatDate } from '../../lib/format';
import { imageUrl, IMAGE_VARIANTS } from '../../lib/images';
import { setPublicCache } from '../../lib/cache';

const env = Astro.locals.runtime.env;
setPublicCache(Astro.response); // anonymous, identical for all visitors (P3-3)
const pageRaw = Number(Astro.url.searchParams.get('page'));
const page = Number.isInteger(pageRaw) && pageRaw > 0 ? pageRaw : 1;

const { rows, total, page: current, pageCount } = await getPublishedAnnouncements(env, page);
const { width, height } = IMAGE_VARIANTS.card;

function pageHref(n: number): string {
  return n <= 1 ? '/announcements' : `/announcements?page=${n}`;
}
const pages = Array.from({ length: pageCount }, (_, i) => i + 1);
---

<BaseLayout
  title="Announcements"
  description="News and updates from Togomoto Industries — new arrivals, services and company announcements."
>
  <div class="container page">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> <span aria-hidden="true">/</span>
      <span class="current">Announcements</span>
    </nav>

    <header class="intro">
      <h1>Announcements</h1>
      <p class="lede">News, new arrivals and updates from the Togomoto team.</p>
    </header>

    {
      rows.length === 0 ? (
        <div class="empty">
          <p>No announcements have been published yet. Check back soon.</p>
        </div>
      ) : (
        <ul class="ann-grid" role="list">
          {rows.map((a, i) => (
            <li>
              <a class="ann-card" href={`/announcements/${a.slug}`}>
                <div class="ann-media">
                  {a.coverImageR2Key ? (
                    <img
                      src={imageUrl(a.coverImageR2Key, 'card')}
                      width={width}
                      height={height}
                      alt={a.title}
                      loading={i < 3 ? 'eager' : 'lazy'}
                      decoding="async"
                    />
                  ) : (
                    <div class="ann-placeholder" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
                      </svg>
                    </div>
                  )}
                </div>
                <div class="ann-body">
                  {a.publishedAt && <p class="ann-date">{formatDate(a.publishedAt)}</p>}
                  <h2 class="ann-title">{a.title}</h2>
                  {a.excerpt && <p class="ann-excerpt">{a.excerpt}</p>}
                  <span class="ann-more">Read more <span aria-hidden="true">→</span></span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }

    {
      pageCount > 1 && (
        <nav class="pagination" aria-label="Pagination">
          <a class="page-btn" href={pageHref(current - 1)} aria-disabled={current <= 1} tabindex={current <= 1 ? -1 : undefined}>Prev</a>
          {pages.map((n) => (
            <a class="page-btn" href={pageHref(n)} aria-current={n === current ? 'page' : undefined}>{n}</a>
          ))}
          <a class="page-btn" href={pageHref(current + 1)} aria-disabled={current >= pageCount} tabindex={current >= pageCount ? -1 : undefined}>Next</a>
        </nav>
      )
    }
    <p class="total muted">{total} announcement{total === 1 ? '' : 's'}</p>
  </div>
</BaseLayout>

<style>
  .page { padding-block: var(--space-5) var(--space-7); }
  .crumbs { color: var(--color-muted); font-size: var(--text-sm); margin-bottom: var(--space-5); }
  .crumbs a { color: var(--color-muted); }
  .crumbs a:hover { color: var(--color-primary); }
  .crumbs .current { color: var(--color-text); }

  .intro { margin-bottom: var(--space-6); }
  .lede { color: var(--color-muted); font-size: var(--text-lg); }

  .empty {
    padding: var(--space-8) var(--space-5);
    text-align: center;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    color: var(--color-muted);
  }

  .ann-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }
  .ann-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    color: var(--color-text);
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  .ann-card:hover { text-decoration: none; transform: translateY(-3px); border-color: var(--color-primary); }
  .ann-media { position: relative; aspect-ratio: 4 / 3; background: var(--color-surface-2); }
  .ann-media img { width: 100%; height: 100%; object-fit: cover; }
  .ann-placeholder { position: absolute; inset: 0; display: grid; place-items: center; color: var(--color-muted); }
  .ann-body { padding: var(--space-4); display: flex; flex-direction: column; gap: var(--space-2); flex: 1; }
  .ann-date { margin: 0; color: var(--color-muted); font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.04em; }
  .ann-title { margin: 0; font-size: var(--text-lg); }
  .ann-excerpt { margin: 0; color: var(--color-muted); font-size: var(--text-sm); }
  .ann-more { margin-top: auto; color: var(--color-primary); font-weight: 600; font-size: var(--text-sm); }

  .pagination { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-6); }
  .page-btn {
    min-width: 40px; padding: var(--space-2) var(--space-3); text-align: center;
    border: 1px solid var(--color-border); border-radius: var(--radius-md); color: var(--color-text); font-weight: 600;
  }
  .page-btn:hover { text-decoration: none; border-color: var(--color-primary); }
  .page-btn[aria-current='page'] { background: var(--color-primary); color: var(--color-primary-ink); border-color: var(--color-primary); }
  .page-btn[aria-disabled='true'] { opacity: 0.4; pointer-events: none; }
  .total { margin-top: var(--space-4); font-size: var(--text-sm); }
  .muted { color: var(--color-muted); }

  @media (max-width: 900px) { .ann-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .ann-grid { grid-template-columns: 1fr; } }
</style>
