---
// Announcement detail (spec §5.8, PLAN P2-5). SSR — renders title, cover image,
// date, author, and the Markdown body rendered to SANITISED HTML (lib/markdown.ts,
// AGENTS.md §4). 404 (via the styled 404 page) for unpublished or unknown slugs.
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedAnnouncementBySlug } from '../../lib/announcements';
import { renderMarkdown } from '../../lib/markdown';
import { formatDate } from '../../lib/format';
import { imageUrl, IMAGE_VARIANTS } from '../../lib/images';
import { articleLd } from '../../lib/jsonld';
import { setPublicCache } from '../../lib/cache';

const slug = Astro.params.slug as string;
const announcement = await getPublishedAnnouncementBySlug(Astro.locals.runtime.env, slug);
if (!announcement) return Astro.rewrite('/404');
setPublicCache(Astro.response); // anonymous, identical for all visitors (P3-3)

const bodyHtml = await renderMarkdown(announcement.body);
const { width, height } = IMAGE_VARIANTS.carousel;
const metaDescription = announcement.excerpt ?? `${announcement.title} — Togomoto Industries.`;

const origin = (Astro.site ?? new URL(Astro.url.origin)).origin;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const articleJsonLd = articleLd({
  url: canonicalUrl,
  headline: announcement.title,
  description: announcement.excerpt,
  datePublished: announcement.publishedAt?.toISOString() ?? null,
  dateModified: announcement.updatedAt?.toISOString() ?? null,
  author: announcement.author,
  image: announcement.coverImageR2Key
    ? new URL(imageUrl(announcement.coverImageR2Key, 'carousel'), Astro.site ?? Astro.url).href
    : null,
  origin,
});
---

<BaseLayout title={announcement.title} description={metaDescription}>
  <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(articleJsonLd)} />
  <article class="container article">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> <span aria-hidden="true">/</span>
      <a href="/announcements">Announcements</a> <span aria-hidden="true">/</span>
      <span class="current">{announcement.title}</span>
    </nav>

    <header class="article-head">
      <p class="meta">
        {announcement.publishedAt && <time datetime={announcement.publishedAt.toISOString()}>{formatDate(announcement.publishedAt)}</time>}
        {announcement.author && <span class="by"> · by {announcement.author}</span>}
      </p>
      <h1>{announcement.title}</h1>
    </header>

    {
      announcement.coverImageR2Key && (
        <img
          class="cover"
          src={imageUrl(announcement.coverImageR2Key, 'carousel')}
          width={width}
          height={height}
          alt={announcement.title}
          loading="eager"
          decoding="async"
        />
      )
    }

    <div class="prose" set:html={bodyHtml}></div>

    <p class="back"><a href="/announcements">← All announcements</a></p>
  </article>
</BaseLayout>

<style>
  .article { max-width: 760px; padding-block: var(--space-5) var(--space-8); }
  .crumbs { color: var(--color-muted); font-size: var(--text-sm); margin-bottom: var(--space-5); }
  .crumbs a { color: var(--color-muted); }
  .crumbs a:hover { color: var(--color-primary); }
  .crumbs .current { color: var(--color-text); }

  .article-head { margin-bottom: var(--space-5); }
  .meta { color: var(--color-muted); font-size: var(--text-sm); margin: 0 0 var(--space-2); text-transform: uppercase; letter-spacing: 0.04em; }
  .article-head h1 { font-size: var(--text-3xl); }

  .cover {
    width: 100%;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    margin-bottom: var(--space-6);
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .back { margin-top: var(--space-7); }

  /* Rendered Markdown (sanitised HTML). Scoped via :global so the injected
     content picks up these styles. */
  .prose :global(h2) { font-size: var(--text-2xl); margin-top: var(--space-6); }
  .prose :global(h3) { font-size: var(--text-xl); margin-top: var(--space-5); }
  .prose :global(p) { margin: 0 0 var(--space-4); line-height: 1.7; }
  .prose :global(ul),
  .prose :global(ol) { margin: 0 0 var(--space-4); padding-left: var(--space-6); }
  .prose :global(li) { margin-bottom: var(--space-2); }
  .prose :global(a) { color: var(--color-link); text-decoration: underline; }
  .prose :global(img) { border-radius: var(--radius-md); margin: var(--space-4) 0; }
  .prose :global(blockquote) {
    margin: 0 0 var(--space-4);
    padding: var(--space-2) var(--space-5);
    border-left: 3px solid var(--color-primary);
    color: var(--color-muted);
  }
  .prose :global(pre) {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .prose :global(code) { font-family: var(--font-mono); font-size: 0.9em; }
  .prose :global(table) { width: 100%; border-collapse: collapse; margin: 0 0 var(--space-4); }
  .prose :global(th),
  .prose :global(td) { border: 1px solid var(--color-border); padding: var(--space-2) var(--space-3); text-align: left; }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--color-border); margin: var(--space-6) 0; }
</style>
