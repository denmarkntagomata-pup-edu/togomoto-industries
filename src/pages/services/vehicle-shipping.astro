---
// Vehicle shipping (spec §5.5, PLAN P2-3). SSG shell — informational content
// describing the point-A-to-point-B shipping service. This is NOT a booking
// system; it is content only, closing with the shared inquiry form
// (source=vehicle_shipping). The form POSTs to the SSR /api/inquiries endpoint.
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import ConnectSection from '../../components/ConnectSection.astro';

// Indicative copy (spec §5.5 — final copy supplied separately).
const stages = [
  {
    title: 'Inquiry & quote',
    body: 'Tell us the origin, destination and the vehicle(s) involved. We assess the route and send an indicative shipping estimate.',
  },
  {
    title: 'Booking & acquisition',
    body: 'Once confirmed, we arrange vanning and book cargo space. If the unit still needs to be acquired, we coordinate that first.',
  },
  {
    title: 'Shipping',
    body: 'The unit is shipped point-to-point. We keep you updated on schedule and expected arrival.',
  },
  {
    title: 'Clearance & release',
    body: 'On arrival we handle customs clearance and the paperwork. Container units can be delivered; larger vehicles are pulled out from the port once cleared.',
  },
];
---

<BaseLayout
  title="Vehicle shipping"
  description="Point-to-point vehicle shipping with customs clearance and release handled for you — Togomoto Industries."
>
  <div class="container page">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> <span aria-hidden="true">/</span>
      <span>Services</span> <span aria-hidden="true">/</span>
      <span class="current">Vehicle shipping</span>
    </nav>

    <header class="intro">
      <h1>Vehicle shipping</h1>
      <p class="lede">
        Need a vehicle moved from point A to point B? We handle shipping logistics,
        customs clearance and release so your unit arrives ready to use. This is a
        service we coordinate for you — not a self-serve booking system, so reach out
        and we'll take it from there.
      </p>
    </header>

    <ol class="stages" role="list">
      {
        stages.map((s, i) => (
          <li class="stage">
            <span class="stage-num" aria-hidden="true">{i + 1}</span>
            <div>
              <h2 class="stage-title">{s.title}</h2>
              <p class="stage-body">{s.body}</p>
            </div>
          </li>
        ))
      }
    </ol>

  </div>

  <ConnectSection
    source="vehicle_shipping"
    submitLabel="Request a shipping quote"
    heading="Connect and talk to us!"
    lede="Share your route and the unit details, and we'll send a shipping estimate."
  />
</BaseLayout>

<style>
  .page {
    padding-block: var(--space-5) var(--space-7);
  }
  .crumbs {
    color: var(--color-muted);
    font-size: var(--text-sm);
    margin-bottom: var(--space-5);
  }
  .crumbs a {
    color: var(--color-muted);
  }
  .crumbs a:hover {
    color: var(--color-primary);
  }
  .crumbs .current {
    color: var(--color-text);
  }

  .intro {
    max-width: 70ch;
    margin-bottom: var(--space-7);
  }
  .lede {
    color: var(--color-muted);
    font-size: var(--text-lg);
  }

  .stages {
    list-style: none;
    margin: 0 0 var(--space-8);
    padding: 0;
    display: grid;
    gap: var(--space-4);
    max-width: 820px;
  }
  .stage {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    align-items: start;
    padding: var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }
  .stage-num {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-pill);
    background: var(--color-primary);
    color: var(--color-primary-ink);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-lg);
  }
  .stage-title {
    margin: 0 0 var(--space-2);
    font-size: var(--text-lg);
  }
  .stage-body {
    margin: 0;
    color: var(--color-muted);
  }
</style>
