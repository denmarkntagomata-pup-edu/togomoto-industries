---
// Auction request (spec §5.4, PLAN P2-2). SSG shell — static informational
// content describing the auction-request process as ordered steps, closing with
// the shared inquiry form (source=auction_request). The form POSTs to the SSR
// /api/inquiries endpoint, so a prerendered shell is fine.
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import ConnectSection from '../../components/ConnectSection.astro';

// Indicative copy (spec §5.4 — final copy supplied separately).
const steps = [
  {
    title: 'Tell us what you need',
    body: 'Specify the unit you are looking for, or pick one directly from a Japan auction. We help you shortlist based on your budget, use-case and timeline.',
  },
  {
    title: 'Acquisition & payment',
    body: 'Once a unit is chosen we acquire it on your behalf. Payment is settled via telegraphic or online transfer, after which vanning and shipping are scheduled.',
  },
  {
    title: 'Shipping & clearance',
    body: 'While the unit is in transit, we handle customs payment and LTO registration on arrival. Right-hand-drive conversion is available on request.',
  },
  {
    title: 'Release & delivery',
    body: 'Units shipped in containers are eligible for delivery. Trucks and similar vehicles are pulled out by the client from Subic once cleared.',
  },
];
---

<BaseLayout
  title="Auction request"
  description="Source a specific unit straight from Japan auctions — Togomoto handles acquisition, payment, shipping, customs clearance and LTO registration."
>
  <div class="container page">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> <span aria-hidden="true">/</span>
      <span>Services</span> <span aria-hidden="true">/</span>
      <span class="current">Auction request</span>
    </nav>

    <header class="intro">
      <h1>Auction request</h1>
      <p class="lede">
        Looking for a specific unit? We source vehicles and equipment directly from
        Japan auctions and manage the whole process end to end — from acquisition to
        clearance and registration here in the Philippines.
      </p>
    </header>

    <ol class="steps" role="list">
      {
        steps.map((s, i) => (
          <li class="step">
            <span class="step-num" aria-hidden="true">{i + 1}</span>
            <div>
              <h2 class="step-title">{s.title}</h2>
              <p class="step-body">{s.body}</p>
            </div>
          </li>
        ))
      }
    </ol>

  </div>

  <ConnectSection
    source="auction_request"
    submitLabel="Send auction request"
    heading="Connect and talk to us!"
    lede="Tell us what you're after and we'll send sourcing options and an estimate."
  />
</BaseLayout>

<style>
  .page {
    padding-block: var(--space-5) var(--space-7);
  }
  .crumbs {
    color: var(--color-muted);
    font-size: var(--text-sm);
    margin-bottom: var(--space-5);
  }
  .crumbs a {
    color: var(--color-muted);
  }
  .crumbs a:hover {
    color: var(--color-primary);
  }
  .crumbs .current {
    color: var(--color-text);
  }

  .intro {
    max-width: 70ch;
    margin-bottom: var(--space-7);
  }
  .lede {
    color: var(--color-muted);
    font-size: var(--text-lg);
  }

  .steps {
    list-style: none;
    margin: 0 0 var(--space-8);
    padding: 0;
    display: grid;
    gap: var(--space-4);
    max-width: 820px;
  }
  .step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    align-items: start;
    padding: var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }
  .step-num {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-pill);
    background: var(--color-primary);
    color: var(--color-primary-ink);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-lg);
  }
  .step-title {
    margin: 0 0 var(--space-2);
    font-size: var(--text-lg);
  }
  .step-body {
    margin: 0;
    color: var(--color-muted);
  }
</style>
